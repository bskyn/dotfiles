[user]
	name = bskyn
	email = bao.cnguyen2@gmail.com

[core]
	autocrlf = false
	safecrlf = false
	excludesfile = ~/.gitignore_global

[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	type = cat-file -t
	dump = cat-file -pZZ

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[pager]
	branch = false

[pull]
	rebase = true
